# Vorlage für scripts/deploy.sh – als .deploy.env kopieren und ausfüllen.
# .deploy.env wird nicht eingecheckt.
#
# Werte aus dem Add-on „Advanced SSH & Web Terminal“:
#   HA_HOST      Hostname oder IP-Adresse von Home Assistant
#   HA_SSH_PORT  Port aus Konfiguration → Netzwerk
#   HA_SSH_USER  Benutzername aus Konfiguration → ssh → username
HA_HOST=
HA_SSH_PORT=
HA_SSH_USER=

# Home Assistant nach dem Kopieren neu starten: 1 = ja, 0 = nein
HA_RESTART=1
